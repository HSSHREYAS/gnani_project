# Copy this file to .env and fill in your values. Never commit the real .env.

# PostgreSQL connection string
MATSYAMITRA_DATABASE_URL=postgresql://postgres:password@localhost:5432/matsyamitra

# Google Earth Engine project (server-side Python backend only)
MATSYAMITRA_GEE_PROJECT=your-gee-project-id

# Gnani.ai Speech API — server-side secret only. Never expose in the app.
GNANI_API_KEY=your-gnani-api-key-here
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGES=kn-IN,en-IN
GNANI_STT_FORMAT=codemix
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE_KN=Kavin
GNANI_TTS_SPEED=1.0
GNANI_MAX_AUDIO_BYTES=15728640
